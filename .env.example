# Lucky Sushi & Chinese - environment variables
# Copy to .env.local for local development. On Vercel, set the same
# variables in Project Settings -> Environment Variables.

# --- Supabase (PostgreSQL database + auth) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon/publishable key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key - SERVER ONLY, never expose in the browser.
# Required by the admin panel for user management and menu writes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.luckysushichinese.com.tr
